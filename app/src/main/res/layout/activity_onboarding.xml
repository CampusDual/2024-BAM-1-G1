<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/fl_container_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rounded_bottom"
        app:layout_constraintDimensionRatio="1:1.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fl_container_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_container_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <LinearLayout
                android:id="@+id/bullets_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/bullet1"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/selector_bullet" />

                <ImageView
                    android:id="@+id/bullet2"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/selector_bullet" />

                <ImageView
                    android:id="@+id/bullet3"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:background="@drawable/selector_bullet" />
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                >

                <TextView
                    android:id="@+id/tv_onboarding_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/title_onboarding_one"
                    android:text="@string/onboarding_one_title">
                </TextView>

                <TextView
                    android:id="@+id/tv_onboarding_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="24dp"
                    style="@style/text_body"
                    android:text="@string/onboarding_one_body">
                </TextView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_onb_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_arrow_right"

                    android:backgroundTint="@color/color_main"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="16dp"
                    android:padding="18dp"
                    style="@style/button_solid_16dp" />


            </LinearLayout>
            
        </androidx.constraintlayout.widget.ConstraintLayout>



    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>