<?xml version="1.0" encoding="utf-8"?>
<ScrollView

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    tools:context=".presentation.auth.profile.ActivityProfile">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Título -->
        <TextView
            android:id="@+id/tv_profile_title"
            style="@style/title_30sp"
            android:layout_marginTop="60dp"
            android:text="@string/profile_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Contenedor del apodo -->
        <LinearLayout
            android:id="@+id/ll_profile_container_nick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_title">

            <TextView
                android:id="@+id/tv_profile_title_nick"
                style="@style/title_h3_14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title_nick" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_input_nick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/color_main"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"> <!-- Desactiva el hint flotante -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_prifile_input_nick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_font"
                    android:hint="@string/profile_input_nick"
                    android:inputType="text"
                    android:padding="22dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_secondary_grey" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Contenedor de la edad -->
        <LinearLayout
            android:id="@+id/ll_profile_container_age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_profile_container_nick">

            <TextView
                android:id="@+id/tv_profile_title_age"
                style="@style/title_h3_14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title_age" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_input_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/color_main"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"> <!-- Desactiva el hint flotante -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_input_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_font"
                    android:hint="@string/profile_input_age"
                    android:inputType="text"
                    android:padding="22dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_secondary_grey" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_profile_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/ll_profile_options"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_profile_container_age">

            <!-- Contenedor de la pais -->
            <LinearLayout
                android:id="@+id/ll_profile_container_country"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/ll_profile_container_province"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_profile_title_country"
                    style="@style/title_h3_14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title_country" />

                <!-- Desactiva el hint flotante -->

                <com.hbb20.CountryCodePicker
                    android:id="@+id/ccp_profile_input_country"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    app:ccp_textSize="30dp"
                    app:ccp_useFlagEmoji="true"
                    app:ccp_autoDetectLanguage="true"
                    app:ccp_autoDetectCountry="true"
                    app:ccp_showFlag="true"
                    app:ccp_showFullName="false"
                    app:ccp_showNameCode="false"
                    app:ccp_showPhoneCode="false"
                    app:ccpDialog_background="@color/white" />
            </LinearLayout>
            <!-- Contenedor de la ciudad -->
            <LinearLayout
                android:id="@+id/ll_profile_container_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ll_profile_container_country"
                app:layout_constraintTop_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_profile_title_province"
                    style="@style/title_h3_14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title_province" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_profile_input_province"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/color_main"
                    app:boxStrokeWidth="1dp"
                    app:hintEnabled="false"> <!-- Desactiva el hint flotante -->

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_profile_input_province"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_font"
                        android:hint="@string/profile_input_province"
                        android:inputType="text"
                        android:padding="22dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_secondary_grey" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Opciones  -->
        <LinearLayout
            android:id="@+id/ll_profile_options"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_profile_container">

            <TextView
                android:id="@+id/tv_profile_title_options"
                style="@style/title_h3_14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_option_title" />


            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:padding="0dp"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <!-- Botón a -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_option_a"
                    style="@style/button_solid_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="3dp"
                    android:padding="24dp"
                    android:text="@string/profile_option_a"
                    app:cornerRadius="16dp" />

                <!-- Botón b -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_option_b"
                    style="@style/button_solid_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="3dp"
                    android:padding="24dp"
                    android:text="@string/profile_option_b"
                    app:cornerRadius="16dp" />

                <!-- Botón c -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_option_c"
                    style="@style/button_solid_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="3dp"
                    android:padding="24dp"
                    android:text="@string/profile_option_c"
                    app:cornerRadius="16dp" />

                <!-- Botón d -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b_option_d"
                    style="@style/button_solid_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="3dp"
                    android:padding="24dp"
                    android:text="@string/profile_option_d"
                    app:cornerRadius="16dp" />

            </GridLayout>


        </LinearLayout>


        <!-- Botón de inicio de sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_login_button"
            style="@style/button_solid_16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/color_main"
            android:padding="18dp"
            android:text="@string/profile_button"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_profile_options" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

